# 图书管理服务的环境变量
#
# 使用方法：复制成 .env 并填真实值（该文件已在 .gitignore 中）
#   cp .env.example .env
#
# 这些值要和 robot-arm 仓库 server/config.js 里的 DB 配置一致 ——
# 因为图书管理要连同一个数据库，查 sessions 表校验全站登录状态。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=arm_app
DB_PASSWORD=改成你的数据库密码
DB_NAME=robot_arm

# 服务监听端口（Nginx 会转发到这里）
LIBRARY_PORT=5001
